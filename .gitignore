node_modules/
out/

# M0 artifacts: large or regenerable. The verdict, the survivor list and the
# owner's labels ARE committed — they are the study's evidence.
m0/results/shots/
m0/results/smoke/
m0/results/evidence/
m0/results/labels.demo.jsonl

# Same, for any second corpus measured through --set (m0/validation, ...).
m0/*/results/shots/
m0/*/results/smoke/
m0/*/results/evidence/
m0/*/results/labels.demo.jsonl

# AI investigator: caches and evidence dumps, both regenerable.
ai/.corpus-cache/
ai/.evidence-v2/

# Credentials. The AI investigator reads OPENAI_API_KEY from the environment;
# a .env here is a convenience for local runs and must never be committed.
.env
.env.*
!.env.example
